{
  "name": "devsolve",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "sitemap:core": "next-sitemap --config next-sitemap.config.mjs",
    "sitemap:programmatic": "node scripts/generate-programmatic-sitemaps.mjs",
    "ai-quality:gate": "node scripts/ai-quality-gatekeeper.mjs",
    "ai-quality:edge": "node --import tsx scripts/verify-edge-corpus-quality.mjs",
    "ai-quality:agent": "node -e \"import('./scripts/lib/ai-indexing-agent.mjs').then(m=>console.log(m.agentBanner()))\"",
    "ai-quality:sitemap": "node scripts/generate-ai-quality-sitemaps.mjs",
    "ai-quality:indexnow": "node scripts/ai-quality-indexnow-submit.mjs",
    "ramp:verify": "node --import tsx scripts/verify-ramp-sitemap-sync.mjs",
    "discovery:ping": "node scripts/free-discovery-ping.mjs",
    "feed": "node scripts/generate-feed.mjs",
    "edge:waf": "node scripts/deploy-waf-bot-block.mjs",
    "edge:cache-rules": "node scripts/deploy-cache-rules.mjs",
    "edge:verify": "node scripts/verify-live-access.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck:app": "tsc --noEmit",
    "typecheck:functions": "tsc --project tsconfig.functions.json --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck:functions"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.0.9",
    "lucide-react": "^0.344.0",
    "marked": "^12.0.1",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.5.3"
  }
}

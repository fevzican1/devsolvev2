{
  "compilerOptions": {
    "lib": ["esnext", "WebWorker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "incremental": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "functions/**/*.ts",
    "functions/**/*.mts",
    "src/lib/quality/eligibility.ts",
    "src/lib/quality/scoring.ts",
    "src/lib/quality/scoringPage.ts",
    "src/lib/seo/seoText.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out"
  ]
}

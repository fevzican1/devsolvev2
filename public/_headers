/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 0
  Content-Signal: search=yes, ai-train=no
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1
  Cache-Control: public, max-age=300

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Aggressive edge cache for every sitemap variant. Google's "temporary
# processing error" on /sitemap-*.xml is almost always caused by the origin
# (this Cloudflare Pages project) being slow or briefly unavailable when
# Googlebot fetches the index. By pinning long max-age + s-maxage + the
# Cloudflare-specific CDN-Cache-Control header, every sitemap is served
# directly from the edge for 24h and the origin is only touched on miss.
/sitemap-main-pages.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  CDN-Cache-Control: max-age=86400
  Cloudflare-CDN-Cache-Control: max-age=86400
  Content-Type: application/xml; charset=utf-8

/sitemap-index.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  CDN-Cache-Control: max-age=86400
  Cloudflare-CDN-Cache-Control: max-age=86400
  Content-Type: application/xml; charset=utf-8

/sitemap-programmatic-*.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  CDN-Cache-Control: max-age=86400
  Cloudflare-CDN-Cache-Control: max-age=86400
  Content-Type: application/xml; charset=utf-8

/sitemap-tier*.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  CDN-Cache-Control: max-age=86400
  Cloudflare-CDN-Cache-Control: max-age=86400
  Content-Type: application/xml; charset=utf-8

/sitemap-priority-*.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  CDN-Cache-Control: max-age=86400
  Cloudflare-CDN-Cache-Control: max-age=86400
  Content-Type: application/xml; charset=utf-8

/sitemap-*.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  CDN-Cache-Control: max-age=86400
  Cloudflare-CDN-Cache-Control: max-age=86400
  Content-Type: application/xml; charset=utf-8

# RSS syndication feed (static, generated at build by scripts/generate-feed.mjs).
# Served straight from the edge cache like any sitemap — zero Function cost.
/feed.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  CDN-Cache-Control: max-age=3600
  Cloudflare-CDN-Cache-Control: max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

# /k/* responses are produced by the Pages Function (functions/k/[[slug]].ts)
# which sets its OWN Cache-Control per response type:
#   - 200 OK canonical → max-age=31536000, immutable (cached 1 year at edge)
#   - 301 legacy       → max-age=86400 (24h)
#   - 404 unknown      → max-age=60, s-maxage=300 (5min edge cache)
# We DO NOT set Cache-Control here because any value here could be merged
# with the function's value and either weaken the 1-year cache (causing a
# 365× increase in Function invocations and budget burn) or strengthen the
# 404 cache (preventing newly-added pages from being discovered).
# X-Robots-Tag is also set by the function for both 200 OK (index, follow)
# and 404 (noindex, follow); we leave the global default header (line 9)
# to cover any edge case where the function header is dropped.
/k/*
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/tools/*
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/guides/*
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/about
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/contact
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/legal/*
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/robots.txt
  Cache-Control: public, max-age=86400

/.well-known/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# Administrative / preview routes — robots.txt blocks crawling, but third-party
# sites can still link to these URLs. A bare robots.txt block does NOT prevent
# Google from listing a URL in search results (it can index based on the link
# alone). The explicit X-Robots-Tag below removes that loophole and produces
# the GSC behaviour we want: "Excluded by 'noindex' tag" instead of "Indexed,
# though blocked by robots.txt". Both routes are still Disallow'd in robots.txt
# to save crawl budget; noindex here covers the link-graph case.
/cmd-center
  X-Robots-Tag: noindex, nofollow

/cmd-center/*
  X-Robots-Tag: noindex, nofollow

/api/*
  X-Robots-Tag: noindex, nofollow

# Cloudflare bot-management / challenge pages — not site content. Bing WMT
# crawls these and reports missing meta description / long titles.
/cdn-cgi/*
  X-Robots-Tag: noindex, nofollow

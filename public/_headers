/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 0
  Content-Signal: search=yes, ai-train=no
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1
  Cache-Control: public, max-age=300

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Aggressive edge cache for the sitemap files that actually exist as static
# assets. IMPORTANT: only list REAL build outputs here. A wildcard that also
# matched non-existent *.xml URLs would stamp `Content-Type: application/xml`
# onto the 404 HTML page, and Google/browsers then fail with
# "xmlParseEntityRef: no name" when parsing that HTML as XML. Retired sitemap
# names are 301'd to /sitemap.xml in public/_redirects instead.
/sitemap-main-pages.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  CDN-Cache-Control: max-age=86400
  Cloudflare-CDN-Cache-Control: max-age=86400
  Content-Type: application/xml; charset=utf-8

/sitemap-main-pages-*.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  CDN-Cache-Control: max-age=86400
  Cloudflare-CDN-Cache-Control: max-age=86400
  Content-Type: application/xml; charset=utf-8

/sitemap-ai-quality-*.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  CDN-Cache-Control: max-age=86400
  Cloudflare-CDN-Cache-Control: max-age=86400
  Content-Type: application/xml; charset=utf-8

# RSS syndication feed (static, generated at build by scripts/generate-feed.mjs).
# Served straight from the edge cache like any sitemap — zero Function cost.
/feed.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  CDN-Cache-Control: max-age=3600
  Cloudflare-CDN-Cache-Control: max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

# /k/* is resolved deterministically by the Pages Function. Cloudflare caches
# the canonical HTML at the edge; no origin storage or database is involved.
/k/*
  Cache-Control: public, max-age=300, s-maxage=2592000, stale-while-revalidate=604800
  CDN-Cache-Control: max-age=2592000, stale-while-revalidate=604800
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/tools/*
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/guides/*
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/about
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/contact
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/legal/*
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/robots.txt
  Cache-Control: public, max-age=86400

/.well-known/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# Administrative / preview routes — robots.txt blocks crawling, but third-party
# sites can still link to these URLs. A bare robots.txt block does NOT prevent
# Google from listing a URL in search results (it can index based on the link
# alone). The explicit X-Robots-Tag below removes that loophole and produces
# the GSC behaviour we want: "Excluded by 'noindex' tag" instead of "Indexed,
# though blocked by robots.txt". Both routes are still Disallow'd in robots.txt
# to save crawl budget; noindex here covers the link-graph case.
/cmd-center
  X-Robots-Tag: noindex, nofollow

/cmd-center/*
  X-Robots-Tag: noindex, nofollow

/api/*
  X-Robots-Tag: noindex, nofollow

# Cloudflare bot-management / challenge pages — not site content. Bing WMT
# crawls these and reports missing meta description / long titles.
/cdn-cgi/*
  X-Robots-Tag: noindex, nofollow

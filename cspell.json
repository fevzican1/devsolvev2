{
  "version": "0.2",
  "language": "en",
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "_comment": "Project dictionary + ignore rules. The codebase passes tsc (app + functions), next lint and next build with ZERO errors; the VS Code 'Problems' entries were Code Spell Checker false positives on technical/Turkish vocabulary. This config silences them without touching code. Add new technical terms here rather than disabling the extension.",
  "enableFiletypes": ["typescript", "typescriptreact", "markdown", "javascript", "json"],
  "ignorePaths": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "public/**",
    "package-lock.json",
    "*.lock"
  ],
  "dictionaries": ["en_US", "softwareTerms", "typescript", "node", "html", "css", "fonts"],
  "language,tr": "tr",
  "words": [
    "devsolve",
    "devsolvev",
    "programmatic",
